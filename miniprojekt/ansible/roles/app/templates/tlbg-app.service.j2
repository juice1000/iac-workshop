{# Dienstdatei fuer systemd: wer startet was, mit welchem Benutzer und welchen Variablen (EnvironmentFile). Restart=on-failure startet die Anwendung nach einem Absturz neu. #}
# {{ ansible_managed }}
[Unit]
Description=TLBG Beispielanwendung
After=network-online.target

[Service]
User={{ app_user }}
EnvironmentFile=/etc/tlbg-app.env
ExecStart=/usr/bin/python3 {{ app_dir }}/app.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
