# Erzeugt von Terraform (miniprojekt/terraform). Nicht von Hand aendern.
%{ for rolle in rollen ~}
[${rolle}]
%{ for name, s in server ~}
%{ if s.rolle == rolle ~}
${knoten[name].name} ansible_host=127.0.0.1 ansible_port=${s.ssh_port}
%{ endif ~}
%{ endfor ~}

%{ endfor ~}
[all:vars]
ansible_user=root
ansible_ssh_private_key_file=${key_path}
db_host=${db_host}
app_netz=${netz}
app_port=${app_port}
